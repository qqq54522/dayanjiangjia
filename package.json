{
  "name": "onion-deck-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server.mjs",
    "build": "vite build",
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "workspace": "node scripts/workspace.mjs",
    "update": "node scripts/update.mjs",
    "share-code": "node scripts/share-code.mjs",
    "guard": "node scripts/guard.mjs",
    "precommit": "node scripts/guard.mjs --staged"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
