{
  "name": "onion-deck-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/run.mjs",
    "build": "node scripts/build-masters.mjs && vite build",
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "workspace": "node scripts/workspace.mjs",
    "update": "node scripts/update.mjs",
    "share-code": "node scripts/share-code.mjs",
    "guard": "node scripts/guard.mjs",
    "precommit": "node scripts/guard.mjs --staged",
    "test": "node --test tests/*.test.mjs",
    "test:acceptance": "npm run check && npm run build && node --test acceptance/*.test.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fast-xml-parser": "^5.3.0",
    "fflate": "0.8.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
